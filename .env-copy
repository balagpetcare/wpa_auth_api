NODE_ENV=development
PORT=5010
HOST=0.0.0.0
API_PREFIX=/api/v1

# Database
DATABASE_URL="postgresql://wpa_auth_user:wpa_auth_password_123@127.0.0.1:5433/wpa_auth_db?schema=public"
SHADOW_DATABASE_URL="postgresql://wpa_auth_user:wpa_auth_password_123@127.0.0.1:5433/wpa_auth_shadow_db?schema=public"

# Redis / Rate Limit
REDIS_URL="redis://127.0.0.1:6379"
RATE_LIMIT_STORE=memory
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Base URLs
APP_BASE_URL="http://localhost:5012"
API_BASE_URL="http://localhost:5010"
ADMIN_BASE_URL="http://localhost:5012"
ADMIN_PANEL_ORIGIN="http://localhost:5012"
FRONTEND_ORIGIN="http://localhost:5012"

# Public client origins allowed to call this API directly from the browser
# (CORS allowlist). Includes the fixed local dev origins.
ALLOWED_PUBLIC_ORIGINS="http://localhost:5011,http://localhost:5012"

# OAuth / OIDC
OAUTH_ISSUER="http://localhost:5010"
JWT_ISSUER="http://localhost:5010"
AUTH_CODE_TTL_SECONDS=600
SERVICE_TOKEN_TTL_SECONDS=3600

# JWT Secrets
JWT_SECRET="change-me-very-secret-main-jwt-key-12345"
JWT_ACCESS_SECRET="change-me-very-secret-access-token-key-12345"
JWT_REFRESH_SECRET="change-me-very-secret-refresh-token-key-12345"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Optional RSA Keys for JWKS
# JWT_RSA_PRIVATE_KEY and JWT_RSA_PUBLIC_KEY are optional.
# For local development, leave them empty.
JWT_RSA_PRIVATE_KEY=""
JWT_RSA_PUBLIC_KEY=""
JWT_KEY_ID="wpa-local-dev-key"

# Seed Admin
SEED_ADMIN_EMAIL="admin@wpa.com"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Password123!"
SEED_ADMIN_NAME="WPA Super Admin"
FORCE_ADMIN_PASSWORD_RESET=true

# SMTP / Email
# Local development: keep empty if SMTP is not configured.
# System should use safe fallback/console logging in development.
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="WPA Central Auth <noreply@worldpetsassociation.com>"

# Social Login - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5010/api/v1/auth/social/google/callback"

# Social Login - Facebook / Meta
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_CALLBACK_URL="http://localhost:5010/api/v1/auth/social/facebook/callback"

# Social Login - Apple
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
APPLE_CALLBACK_URL="http://localhost:5010/api/v1/auth/social/apple/callback"

# Social Login - Twitter / X
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_CALLBACK_URL="http://localhost:5010/api/v1/auth/social/twitter/callback"

# Social Login - Instagram
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
INSTAGRAM_CALLBACK_URL="http://localhost:5010/api/v1/auth/social/instagram/callback"

# Local Auth Clients / Allowed Origins
DEFAULT_ALLOWED_ORIGINS="http://localhost:5012,http://localhost:5011"
DEFAULT_REDIRECT_URIS="http://localhost:5012/api/auth/callback,http://localhost:5011/api/auth/callback"

# Logging
LOG_LEVEL=debug

# Encryption Key for Credentials
CREDENTIAL_ENCRYPTION_KEY=change-me-very-secret-credential-encryption-key-12345
COMMUNICATION_RETRY_WORKER_ENABLED=true
COMMUNICATION_RATE_LIMIT_ENABLED=true

ADDITIONAL_JWT_AUDIENCES=bpa-admin,wpa-gateway-admin,wpa-auth-admin,furtail-admin
