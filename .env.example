NODE_ENV=development
PORT=5010
# Optional in development. Required in production for shared rate limiting.
REDIS_URL=redis://localhost:6379
# Set to 1 when behind Nginx in production. Leave unset in development.
# TRUST_PROXY=1
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_URL=http://localhost:5010
AUTH_WEB_URL=http://localhost:5011
ADMIN_PANEL_URL=http://localhost:5012
COOKIE_DOMAIN=localhost
DATABASE_URL=postgresql://wpa_auth_user:CHANGE_ME@127.0.0.1:5433/wpa_auth_db
SHADOW_DATABASE_URL=postgresql://wpa_auth_user:CHANGE_ME@127.0.0.1:5433/wpa_auth_shadow_db
JWT_ACCESS_SECRET=change-me-very-secret-access-token-key-12345
JWT_REFRESH_SECRET=change-me-very-secret-refresh-token-key-12345
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
ADMIN_PANEL_ORIGIN=http://localhost:5012
# CORS allowlist for browser clients. Keep this aligned with the deployed
# auth web and admin origins.
ALLOWED_PUBLIC_ORIGINS=http://localhost:5011,http://localhost:5012,http://localhost:3000

# Required — used to encrypt communication-provider secrets at rest
# (see src/lib/credentialEncryption.ts). Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-random-32-plus-character-secret

# OAuth / OIDC
OAUTH_ISSUER=http://localhost:5010
# Optional RSA keys (PEM, base64-encoded) for JWKS/RS256. Falls back to HS256 if
# absent. NOTE: JWKS export is currently a stub even when these are set — see
# docs/wpa-central-auth-api-complete-audit.md ("JWKS Stub") before relying on
# third-party OIDC signature verification.
# JWT_RSA_PRIVATE_KEY=
# JWT_RSA_PUBLIC_KEY=
AUTH_CODE_TTL_SECONDS=600
SERVICE_TOKEN_TTL_SECONDS=3600

# OTP settings
OTP_EXPIRY_MINUTES=10
OTP_APP_NAME=WPA Central Auth
OTP_SUPPORT_EMAIL=support@wpa.local

# Communication abuse protection (src/lib/antiAbuse.ts — checkCommunicationAbuseLimits).
# Rate-limits/caps outbound email+SMS sends, provider test-sends, and manual/bulk
# retries. Requires REDIS_URL to be reachable — fails OPEN (allows the send) if
# Redis is unavailable, so this is a defense-in-depth guard, not the only control.
COMMUNICATION_RATE_LIMIT_ENABLED=true
# Per-recipient caps (phone/email hashed before use as a Redis key).
COMMUNICATION_MAX_SMS_PER_PHONE_PER_HOUR=5
COMMUNICATION_MAX_SMS_PER_PHONE_PER_DAY=10
COMMUNICATION_MAX_EMAIL_PER_ADDRESS_PER_HOUR=5
COMMUNICATION_MAX_EMAIL_PER_ADDRESS_PER_DAY=10
# Per-admin cap on manual "test provider" sends from the admin UI.
COMMUNICATION_MAX_PROVIDER_TEST_PER_ADMIN_HOUR=10
# Max number of delivery-log ids accepted in one bulk-retry/bulk-cancel request.
COMMUNICATION_MAX_BULK_RETRY_COUNT=50
# System-wide caps across all recipients, per channel — a last-resort circuit
# breaker against a runaway loop or compromised flow, not a per-user limit.
COMMUNICATION_SYSTEM_SMS_HOURLY_CAP=200
COMMUNICATION_SYSTEM_SMS_DAILY_CAP=2000
COMMUNICATION_SYSTEM_EMAIL_HOURLY_CAP=1000
COMMUNICATION_SYSTEM_EMAIL_DAILY_CAP=10000
# Enables the background scan (in the communication worker process) that picks
# up due RETRY_SCHEDULED deliveries and retries them. See
# ecosystem.production.config.cjs (wpa-auth-communication-worker app).
COMMUNICATION_RETRY_WORKER_ENABLED=true

# Social login (optional — leave unset to disable a provider)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_CALLBACK_URL=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_CALLBACK_URL=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# TWITTER_CALLBACK_URL=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# INSTAGRAM_CALLBACK_URL=

# Seed configuration
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
FORCE_ADMIN_PASSWORD_RESET=false

# NOTE: The following variables are read directly from process.env by specific
# modules and are NOT part of the central zod schema in src/config/index.ts:
#   - RATE_LIMIT_LOGIN_WINDOW_MS / RATE_LIMIT_LOGIN_MAX (src/middleware/rateLimit.ts)
# Email/SMTP delivery is NOT configured via env vars — it is fully DB-driven
# through the CommunicationProvider system (see src/modules/communication/), whose
# credentials (including SMTP host/port/user/pass) are stored encrypted in the
# database and managed via /admin/communication/providers, not via .env.
# Older/unused variable names such as JWT_SECRET, JWT_ISSUER, JWT_KEY_ID,
# RATE_LIMIT_MAX, RATE_LIMIT_STORE, RATE_LIMIT_WINDOW_MS, LOG_LEVEL,
# DEFAULT_ALLOWED_ORIGINS, DEFAULT_REDIRECT_URIS, FRONTEND_ORIGIN, and legacy
# SMTP_* vars were found in a working .env but are not consumed anywhere in
# src/ — do not rely on them.
