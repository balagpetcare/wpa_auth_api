# Core Database & Infrastructure
DATABASE_URL=postgresql://user:password@localhost:5432/wpa_auth_db

# Required in production — shared Redis instance for cross-process rate limiting.
# All PM2 workers and API servers MUST share the same Redis URL.
REDIS_URL=redis://localhost:6379

# Number of trusted upstream proxy hops. Required so Express reads X-Forwarded-For
# correctly and rate-limits by the real client IP instead of the proxy IP.
#
# Topology → value:
#   Client → Nginx → API                   TRUST_PROXY=1   (single hop)
#   Client → CDN → Nginx → API             TRUST_PROXY=2   (two hops)
#   Client → CDN → LB → Nginx → API        TRUST_PROXY=3   (three hops)
#
# Do NOT set to 'true' in production — it trusts any X-Forwarded-For value
# regardless of source, which allows clients to spoof their IP.
#
# See: https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY=1

# Required Nginx proxy headers — add these to your Nginx server block:
#   proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#   proxy_set_header X-Real-IP         $remote_addr;
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header Host              $host;

# JWT & Auth Settings
JWT_ACCESS_SECRET=your_strong_access_secret
JWT_REFRESH_SECRET=your_strong_refresh_secret
# NOTE: src/config/index.ts reads OAUTH_ISSUER (not JWT_ISSUER) as the OIDC
# issuer value used in /oauth endpoints. JWT_ISSUER is not consumed anywhere in
# src/ — kept commented below for reference only; use OAUTH_ISSUER instead.
# JWT_ISSUER=world-pets-association-auth
OAUTH_ISSUER=https://auth.worldpetsassociation.com
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Required — used to encrypt communication-provider secrets at rest
# (see src/lib/credentialEncryption.ts). Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET

# Optional RSA keys (PEM, base64-encoded) for JWKS/RS256. NOTE: JWKS export is
# currently a stub even when these are set — see
# docs/wpa-central-auth-api-complete-audit.md ("JWKS Stub") before relying on
# third-party OIDC signature verification in production.
# JWT_RSA_PRIVATE_KEY=
# JWT_RSA_PUBLIC_KEY=

# NOTE: Email/SMTP delivery is NOT configured via env vars in this codebase —
# it is fully DB-driven through the CommunicationProvider system (see
# src/modules/communication/). Configure SMTP/SES/SendGrid credentials via
# POST /admin/communication/providers + /providers/:id/credentials once the
# app is running, not via .env. The SMTP_* variables below are NOT read by any
# code in src/ and are kept here only as a historical reference — remove once
# confirmed unnecessary for your deployment tooling.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=465
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password
# SMTP_FROM=noreply@auth.worldpetsassociation.com

# Base URLs
APP_URL=https://auth.worldpetsassociation.com
AUTH_WEB_URL=https://auth.worldpetsassociation.com
ADMIN_PANEL_ORIGIN=https://auth-admin.worldpetsassociation.com
COOKIE_DOMAIN=.worldpetsassociation.com
ALLOWED_PUBLIC_ORIGINS=https://worldpetsassociation.com,https://auth-admin.worldpetsassociation.com

# Social Login Credentials (Optional, but required if enabled in admin)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://auth.worldpetsassociation.com/api/v1/auth/social/google/callback

FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_CALLBACK_URL=https://auth.worldpetsassociation.com/api/v1/auth/social/facebook/callback

APPLE_CLIENT_ID=com.worldpetsassociation.auth
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_CALLBACK_URL=https://auth.worldpetsassociation.com/api/v1/auth/social/apple/callback

TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_CALLBACK_URL=https://auth.worldpetsassociation.com/api/v1/auth/social/twitter/callback

INSTAGRAM_CLIENT_ID=your_instagram_client_id
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret
INSTAGRAM_CALLBACK_URL=https://auth.worldpetsassociation.com/api/v1/auth/social/instagram/callback

# Communication abuse protection (src/lib/antiAbuse.ts — checkCommunicationAbuseLimits).
# Rate-limits/caps outbound email+SMS sends, provider test-sends, and manual/bulk
# retries; requires the shared REDIS_URL above to be reachable from every API and
# worker process — fails OPEN (allows the send) if Redis is unavailable, so this
# is defense-in-depth, not the only control. The values below are safe production
# defaults; tune per your actual sending volume.
COMMUNICATION_RATE_LIMIT_ENABLED=true
# Per-recipient caps (phone/email hashed before use as a Redis key — no PII stored in Redis).
COMMUNICATION_MAX_SMS_PER_PHONE_PER_HOUR=5
COMMUNICATION_MAX_SMS_PER_PHONE_PER_DAY=10
COMMUNICATION_MAX_EMAIL_PER_ADDRESS_PER_HOUR=5
COMMUNICATION_MAX_EMAIL_PER_ADDRESS_PER_DAY=10
# Per-admin cap on manual "test provider" sends from the admin UI.
COMMUNICATION_MAX_PROVIDER_TEST_PER_ADMIN_HOUR=10
# Max number of delivery-log ids accepted in one bulk-retry/bulk-cancel request.
COMMUNICATION_MAX_BULK_RETRY_COUNT=50
# System-wide caps across all recipients, per channel — a last-resort circuit
# breaker against a runaway loop or compromised flow, not a per-user limit.
COMMUNICATION_SYSTEM_SMS_HOURLY_CAP=200
COMMUNICATION_SYSTEM_SMS_DAILY_CAP=2000
COMMUNICATION_SYSTEM_EMAIL_HOURLY_CAP=1000
COMMUNICATION_SYSTEM_EMAIL_DAILY_CAP=10000
# Enables the background scan (in the wpa-auth-communication-worker PM2 app)
# that picks up due RETRY_SCHEDULED deliveries and retries them.
COMMUNICATION_RETRY_WORKER_ENABLED=true
