    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "z-schema": "^5.0.6",
    "zod": "^3.23.8"
  },
