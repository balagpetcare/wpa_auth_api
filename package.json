{
  "name": "wpa_auth_api",
  "version": "1.0.0",
  "description": "WPA Auth API server",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:communication": "tsx src/workers/communication.worker.ts",
    "worker:presence": "tsx src/workers/presence.worker.ts",
    "retention:prune": "tsx src/scripts/retentionPrune.ts",
    "credentials:reencrypt": "tsx src/scripts/reencryptProviderCredentials.ts",
    "smoke:communication-events": "tsx src/scripts/smokeExternalCommunicationEvents.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
