generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                             String                          @id @default(cuid())
  email                          String?                         @unique
  phone                          String?                         @unique
  username                       String?                         @unique
  passwordHash                   String?                         @map("password_hash")
  displayName                    String?                         @map("display_name")
  firstName                      String?                         @map("first_name")
  lastName                       String?                         @map("last_name")
  dateOfBirth                    DateTime?                       @map("date_of_birth") @db.Date
  avatarUrl                      String?                         @map("avatar_url")
  status                         UserStatus                      @default(PENDING_VERIFICATION)
  emailVerifiedAt                DateTime?                       @map("email_verified_at")
  phoneVerifiedAt                DateTime?                       @map("phone_verified_at")
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  bio                            String?
  department                     String?
  interfacePreferences           Json?                           @map("interface_preferences")
  jobTitle                       String?                         @map("job_title")
  lastLoginAt                    DateTime?                       @map("last_login_at")
  lastSeenAt                     DateTime?                       @map("last_seen_at")
  lastPasswordChangedAt          DateTime?                       @map("last_password_changed_at")
  country                        String?
  state                          String?
  city                           String?
  timezone                       String?
  externalRefId                  String?                         @map("external_ref_id")
  registrationSource             String?                         @map("registration_source")
  riskScore                      Int                             @default(0) @map("risk_score")
  failedLoginCount               Int                             @default(0) @map("failed_login_count")
  lastLoginIp                    String?                         @map("last_login_ip")
  lastLoginIpCountry             String?                         @map("last_login_ip_country")
  lastLoginDeviceType            String?                         @map("last_login_device_type")
  lastLoginOs                    String?                         @map("last_login_os")
  lastLoginBrowser               String?                         @map("last_login_browser")
  notificationPreferences        Json?                           @map("notification_preferences")
  organization                   String?
  adminNotifications             AdminNotification[]
  apiKeys                        ApiKey[]
  auditLogs                      AuditLog[]
  authorizationCodes             AuthorizationCode[]
  communicationProviderAuditLogs CommunicationProviderAuditLog[]
  createdCommunicationProviders  CommunicationProvider[]         @relation("CommunicationProviderCreatedBy")
  updatedCommunicationProviders  CommunicationProvider[]         @relation("CommunicationProviderUpdatedBy")
  emailBrandingSettingsUpdated   EmailBrandingSetting[]          @relation("EmailBrandingSettingUpdatedBy")
  emailTemplateAuditLogs         EmailTemplateAuditLog[]
  emailTemplatesUpdated          EmailTemplate[]                 @relation("EmailTemplateUpdatedBy")
  emailVerificationTokens        EmailVerificationToken[]
  phoneChangeTokens              PhoneChangeToken[]
  loginSessions                  LoginSession[]
  oauthAccounts                  OAuthAccount[]
  passwordResetTokens            PasswordResetToken[]
  refreshTokens                  RefreshToken[]
  securityEvents                 SecurityEvent[]
  deletionRequests               DeletionRequest[]
  clientAccess                   UserClientAccess[]
  roles                          UserRole[]
  socialProviderConfigsCreated   SocialIdentityProviderConfig[]  @relation("SocialIdentityProviderConfigCreatedBy")
  socialProviderConfigsUpdated   SocialIdentityProviderConfig[]  @relation("SocialIdentityProviderConfigUpdatedBy")

  @@index([email])
  @@index([phone])
  @@index([username])
  @@index([status])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@index([lastSeenAt])
  @@index([country])
  @@index([state])
  @@index([city])
  @@index([timezone])
  @@index([externalRefId])
  @@index([registrationSource])
  @@index([emailVerifiedAt])
  @@index([phoneVerifiedAt])
  @@index([lastLoginIpCountry])
  @@index([riskScore])
  @@index([failedLoginCount])
  @@index([createdAt, id])
  @@index([lastLoginAt, id])
  @@index([status, createdAt, id])
  @@map("users")
}

model AuthClient {
  id                     String                       @id @default(cuid())
  name                   String
  slug                   String                       @unique
  type                   AuthClientType
  clientId               String                       @unique @map("client_id")
  clientSecretHash       String?                      @map("client_secret_hash")
  allowedOrigins         String[]                     @map("allowed_origins")
  redirectUris           String[]                     @map("redirect_uris")
  allowedScopes          String[]                     @map("allowed_scopes")
  status                 AuthClientStatus             @default(ACTIVE)
  // Additive: per-client identity foundation (Furtail centralized-auth onboarding).
  // Nullable/defaulted so existing clients (e.g. BPA) are completely unaffected:
  // null audience means "fall back to the global ACCESS_TOKEN_AUDIENCE", an
  // empty allowedAuthMethods array means "all methods allowed" (current
  // behavior for every pre-existing client), and null TTL overrides mean
  // "use the global ACCESS_TOKEN_TTL/REFRESH_TOKEN_TTL".
  audience               String?                      @unique @map("audience")
  allowedAuthMethods     String[]                     @default([]) @map("allowed_auth_methods")
  accessTokenTtlSeconds  Int?                         @map("access_token_ttl_seconds")
  refreshTokenTtlSeconds Int?                         @map("refresh_token_ttl_seconds")
  // Additive: per-client "required for a usable profile" fields (e.g.
  // ["phone","displayName"]). Used by the bootstrap endpoint and by the
  // social/OIDC login "needs profile completion" response shape — a
  // first-time social/OIDC login missing any of these fields gets a
  // NEEDS_PROFILE_COMPLETION response instead of a full session. Empty
  // array (the default for every existing client, incl. BPA) means no
  // extra requirement beyond what already existed.
  requiredProfileFields  String[]                     @default([]) @map("required_profile_fields")
  // Additive: whether self-registration (password/email/phone/social
  // first-time signup) is open for this client. Defaults to true so
  // existing clients (BPA) keep working unchanged.
  registrationOpen       Boolean                      @default(true) @map("registration_open")
  createdAt              DateTime                     @default(now()) @map("created_at")
  updatedAt              DateTime                     @updatedAt @map("updated_at")
  apiKeys                ApiKey[]
  auditLogs              AuditLog[]
  authorizationCodes     AuthorizationCode[]
  emailBranding          ClientBranding?
  emailTemplates         EmailTemplate[]
  externalEvents         ExternalCommunicationEvent[]
  loginSessions          LoginSession[]
  refreshTokens          RefreshToken[]
  serviceTokens          ServiceAccessToken[]
  userAccess             UserClientAccess[]
  routingRules           CommunicationRoutingRule[]

  @@index([clientId])
  @@index([slug])
  @@index([status])
  @@map("auth_clients")
}

model SocialIdentityProviderConfig {
  id                    String                            @id @default(cuid())
  provider              OAuthProvider                     @unique
  displayName           String                            @map("display_name")
  clientId              String?                           @map("client_id")
  clientSecretEncrypted String?                           @map("client_secret_encrypted")
  authorizationUrl      String                            @map("authorization_url")
  tokenUrl              String                            @map("token_url")
  userInfoUrl           String?                           @map("user_info_url")
  scopes                String[]
  redirectUri           String                            @map("redirect_uri")
  providerMetadata      Json?                             @map("provider_metadata")
  status                SocialIdentityProviderStatus      @default(INACTIVE)
  environment           SocialIdentityProviderEnvironment @default(LIVE)
  placement             SocialIdentityProviderPlacement   @default(MAIN)
  sortOrder             Int                               @default(0) @map("sort_order")
  showOnLogin           Boolean                           @default(true) @map("show_on_login")
  lastTestAt            DateTime?                         @map("last_test_at")
  lastSuccessfulTestAt  DateTime?                         @map("last_successful_test_at")
  lastTestStatus        String?                           @map("last_test_status")
  lastTestError         String?                           @map("last_test_error")
  createdAt             DateTime                          @default(now()) @map("created_at")
  updatedAt             DateTime                          @updatedAt @map("updated_at")
  createdByAdminId      String?                           @map("created_by_admin_id")
  updatedByAdminId      String?                           @map("updated_by_admin_id")
  createdByAdmin        User?                             @relation("SocialIdentityProviderConfigCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  updatedByAdmin        User?                             @relation("SocialIdentityProviderConfigUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@index([provider])
  @@index([status, showOnLogin, placement, sortOrder])
  @@map("social_identity_provider_configs")
}

model UserClientAccess {
  userId       String                 @map("user_id")
  clientId     String                 @map("client_id")
  roleInClient String?                @map("role_in_client")
  status       UserClientAccessStatus @default(ACTIVE)
  createdAt    DateTime               @default(now()) @map("created_at")
  client       AuthClient             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, clientId])
  @@index([userId])
  @@index([clientId])
  @@map("user_client_access")
}

model Role {
  id          String                @id @default(cuid())
  name        String                @unique
  description String?
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  invitations AdminInvitationRole[]
  permissions RolePermission[]
  users       UserRole[]

  @@index([name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@index([name])
  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  clientId  String     @map("client_id")
  tokenHash String     @unique @map("token_hash")
  scopes    String[]
  expiresAt DateTime   @map("expires_at")
  revokedAt DateTime?  @map("revoked_at")
  userAgent String?    @map("user_agent")
  ipAddress String?    @map("ip_address")
  createdAt DateTime   @default(now()) @map("created_at")
  client    AuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Additive fields for Phase 3.2
  familyId          String?   @map("family_id")
  replacedByTokenId String?   @map("replaced_by_token_id")
  reusedAt          DateTime? @map("reused_at")
  revocationReason  String?   @map("revocation_reason")

  // Additive: Furtail centralized-auth identity foundation. Optional
  // client-supplied device identifier/metadata (platform, model, app
  // version, etc.) — nullable, so existing rows/clients are unaffected.
  deviceId   String? @map("device_id")
  deviceInfo Json?   @map("device_info")

  @@index([userId])
  @@index([clientId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([familyId])
  @@index([deviceId])
  @@map("refresh_tokens")
}

model LoginSession {
  id           String     @id @default(cuid())
  userId       String     @map("user_id")
  clientId     String     @map("client_id")
  sessionToken String     @unique @map("session_token")
  userAgent    String?    @map("user_agent")
  ipAddress    String?    @map("ip_address")
  country      String?
  expiresAt    DateTime   @map("expires_at")
  revokedAt    DateTime?  @map("revoked_at")
  lastActiveAt DateTime   @default(now()) @map("last_active_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  client       AuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Additive fields for Phase 3.2
  revocationReason String? @map("revocation_reason")

  // Additive: Furtail centralized-auth identity foundation (see RefreshToken).
  deviceId   String? @map("device_id")
  deviceInfo Json?   @map("device_info")

  @@index([userId])
  @@index([clientId])
  @@index([sessionToken])
  @@index([expiresAt])
  @@index([userId, createdAt, id])
  @@index([clientId, createdAt, id])
  @@index([deviceId])
  @@map("login_sessions")
}

// Normalized external identity: one row per (provider, providerAccountId)
// linked to exactly one Central Auth User (userId). Multiple rows may point
// at the same userId, which is how one Central Auth account accumulates
// several linked social identities (Google + Facebook + Apple, etc.).
model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  accessToken       String?       @map("access_token")
  refreshToken      String?       @map("refresh_token")
  tokenExpiresAt    DateTime?     @map("token_expires_at")
  rawProfile        Json?         @map("raw_profile")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Additive: normalized identity fields (Furtail centralized-auth
  // identity foundation). All nullable — existing rows are unaffected.
  // - email/emailVerifiedAt, phone/phoneVerifiedAt: the verified contact
  //   info the provider vouched for at link time (used only to prevent
  //   silent duplicate-account merges; never to merge on their own if
  //   unverified — see social.service.ts loginOrLink()).
  // - lastLoginAt: updated every time this specific linked identity is
  //   used to sign in (distinct from User.lastLoginAt, which reflects the
  //   most recent login via ANY method).
  // createdAt above already serves as "linked date" for this identity.
  email           String?   @map("email")
  emailVerifiedAt DateTime? @map("email_verified_at")
  phone           String?   @map("phone")
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
  @@index([provider, providerAccountId])
  @@index([email])
  @@index([phone])
  @@map("oauth_accounts")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// Mirrors EmailVerificationToken for the phone-change OTP flow (see
// requestPhoneChange/confirmPhoneChange in auth.service.ts): stores the
// hashed OTP code (never the raw code) and the target phone number so an
// authenticated user can change their verified phone only after proving
// control of the new number.
model PhoneChangeToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  phone     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("phone_change_tokens")
}

model DeletionRequest {
  id                    String                 @id @default(cuid())
  confirmationCode      String                 @unique @map("confirmation_code")
  requestType           DeletionRequestType    @map("request_type")
  status                DeletionRequestStatus  @default(PENDING_REVIEW)
  provider              OAuthProvider?
  requestSource         DeletionRequestSource  @map("request_source")
  userId                String?                @map("user_id")
  emailHash             String?                @map("email_hash")
  emailReference        String?                @map("email_reference")
  requestedAt           DateTime               @default(now()) @map("requested_at")
  gracePeriodDeadlineAt DateTime?              @map("grace_period_deadline_at")
  processedAt           DateTime?              @map("processed_at")
  cancelledAt           DateTime?              @map("cancelled_at")
  cancelledByUserId     String?                @map("cancelled_by_user_id")
  cancelledByAdminId    String?                @map("cancelled_by_admin_id")
  reviewedAt            DateTime?              @map("reviewed_at")
  reviewedByAdminId     String?                @map("reviewed_by_admin_id")
  failureReason         String?                @map("failure_reason")
  auditMetadata         Json?                  @map("audit_metadata")
  sourceIp              String?                @map("source_ip")
  sourceUserAgent       String?                @map("source_user_agent")
  metaPayload           Json?                  @map("meta_payload")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  events                DeletionRequestEvent[]

  @@index([status, requestedAt])
  @@index([requestType, status, requestedAt])
  @@index([provider, requestedAt])
  @@index([userId, requestedAt])
  @@index([confirmationCode])
  @@map("deletion_requests")
}

model DeletionRequestEvent {
  id                String                   @id @default(cuid())
  deletionRequestId String                   @map("deletion_request_id")
  eventType         DeletionRequestEventType @map("event_type")
  actorSource       String                   @default("SYSTEM") @map("actor_source")
  actorUserId       String?                  @map("actor_user_id")
  actorAdminId      String?                  @map("actor_admin_id")
  metadata          Json?
  createdAt         DateTime                 @default(now()) @map("created_at")
  request           DeletionRequest          @relation(fields: [deletionRequestId], references: [id], onDelete: Cascade)

  @@index([deletionRequestId, createdAt])
  @@index([eventType, createdAt])
  @@map("deletion_request_events")
}

model ApiKey {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  clientId   String     @map("client_id")
  name       String
  keyHash    String     @unique @map("key_hash")
  keyPrefix  String     @map("key_prefix")
  scopes     String[]
  expiresAt  DateTime?  @map("expires_at")
  lastUsedAt DateTime?  @map("last_used_at")
  revokedAt  DateTime?  @map("revoked_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  client     AuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([keyHash])
  @@index([keyPrefix])
  @@map("api_keys")
}

model AuthorizationCode {
  id                  String     @id @default(cuid())
  codeHash            String     @unique @map("code_hash")
  userId              String     @map("user_id")
  clientId            String     @map("client_id")
  redirectUri         String     @map("redirect_uri")
  scopes              String[]
  state               String?
  codeChallenge       String?    @map("code_challenge")
  codeChallengeMethod String?    @map("code_challenge_method")
  nonce               String?
  authTime            DateTime?  @map("auth_time")
  expiresAt           DateTime   @map("expires_at")
  usedAt              DateTime?  @map("used_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  client              AuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([codeHash])
  @@index([userId])
  @@index([clientId])
  @@index([expiresAt])
  @@map("authorization_codes")
}

model ServiceAccessToken {
  id        String     @id @default(cuid())
  clientId  String     @map("client_id")
  tokenHash String     @unique @map("token_hash")
  scopes    String[]
  expiresAt DateTime   @map("expires_at")
  revokedAt DateTime?  @map("revoked_at")
  createdAt DateTime   @default(now()) @map("created_at")
  client    AuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("service_access_tokens")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?     @map("user_id")
  clientId   String?     @map("client_id")
  action     AuditAction
  resource   String?
  resourceId String?     @map("resource_id")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")
  client     AuthClient? @relation(fields: [clientId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([clientId])
  @@index([action])
  @@index([createdAt])
  @@index([createdAt, id])
  @@index([userId, createdAt, id])
  @@map("audit_logs")
}

model SecurityEvent {
  id        String                @id @default(cuid())
  userId    String?               @map("user_id")
  type      SecurityEventType
  severity  SecurityEventSeverity
  ipAddress String?               @map("ip_address")
  userAgent String?               @map("user_agent")
  metadata  Json?
  resolved  Boolean               @default(false)
  createdAt DateTime              @default(now()) @map("created_at")
  user      User?                 @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
  @@index([createdAt, id])
  @@index([userId, createdAt, id])
  @@index([type, createdAt, id])
  @@map("security_events")
}

model AdminNotification {
  id         String                    @id @default(cuid())
  userId     String?                   @map("user_id")
  type       String
  title      String
  message    String
  severity   AdminNotificationSeverity
  category   AdminNotificationCategory
  status     AdminNotificationStatus   @default(UNREAD)
  actionUrl  String?                   @map("action_url")
  metadata   Json?
  readAt     DateTime?                 @map("read_at")
  archivedAt DateTime?                 @map("archived_at")
  createdAt  DateTime                  @default(now()) @map("created_at")
  updatedAt  DateTime                  @updatedAt @map("updated_at")
  user       User?                     @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
  @@index([severity])
  @@index([category])
  @@index([archivedAt])
  @@index([userId, createdAt, id])
  @@map("admin_notifications")
}

model AdminInvitation {
  id              String                @id @default(cuid())
  email           String
  invitedByUserId String                @map("invited_by_user_id")
  invitedUserId   String?               @map("invited_user_id")
  tokenHash       String                @unique @map("token_hash")
  status          InvitationStatus      @default(PENDING)
  message         String?
  expiresAt       DateTime              @map("expires_at")
  acceptedAt      DateTime?             @map("accepted_at")
  revokedAt       DateTime?             @map("revoked_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  roles           AdminInvitationRole[]

  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([invitedByUserId])
  @@index([tokenHash])
  @@map("admin_invitations")
}

model AdminInvitationRole {
  invitationId String          @map("invitation_id")
  roleId       String          @map("role_id")
  invitation   AdminInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([invitationId, roleId])
  @@index([invitationId])
  @@index([roleId])
  @@map("admin_invitation_roles")
}

model CommunicationProvider {
  id                 String                            @id @default(cuid())
  name               String
  code               String                            @unique
  type               CommunicationChannel
  status             CommunicationProviderStatus       @default(INACTIVE)
  environment        CommunicationProviderEnvironment  @default(SANDBOX)
