model CommunicationRoutingRule {
  id                  String                            @id @default(cuid())
  // Phase 2.6A (docs/phase-2-6a-app-aware-communication-routing-ui.md):
  // nullable app scope — null means "system-wide default rule", non-null
  // means "override for this specific connected app/client". Mirrors the
  // existing EmailTemplate.clientId nullable-override pattern already used
  // successfully elsewhere in this schema. Existing rows (all appId=null
  // today) keep working unchanged as system defaults.
  appId               String?                           @map("app_id")
  channel             CommunicationChannel
  countryCode         String?                           @map("country_code")
  purpose             CommunicationPurpose
  language            OtpTemplateLanguage?
  providerId          String?                           @map("provider_id")
  fallbackProviderIds Json?                             @map("fallback_provider_ids")
  priority            Int                               @default(100)
  // Hard kill-switch, distinct from isActive (row-level enable). When
  // false, the channel is blocked outright for the matching app/country/
  // purpose scope — no fallback providers are tried.
  enabled             Boolean                           @default(true)
  // When true (default), if every explicit provider/fallback candidate is
  // unavailable, isGlobal=true providers may be tried as a last-resort
  // international fallback tier. When false, only the explicit chain is
  // tried.
  fallbackEnabled     Boolean                           @default(true) @map("fallback_enabled")
  // Restricts this rule to a specific provider environment; null matches
  // either SANDBOX or LIVE.
  environment         CommunicationProviderEnvironment?
  isActive            Boolean                           @default(true) @map("is_active")
  createdAt           DateTime                          @default(now()) @map("created_at")
  updatedAt           DateTime                          @updatedAt @map("updated_at")
  app                 AuthClient?                       @relation(fields: [appId], references: [id], onDelete: Cascade)
  provider            CommunicationProvider?            @relation(fields: [providerId], references: [id])

  @@index([channel, countryCode, purpose, priority])
  @@index([appId, channel, countryCode, purpose, priority])
  @@map("communication_routing_rules")
}

