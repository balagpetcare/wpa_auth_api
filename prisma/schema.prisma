  // Additive: a per-organization Enterprise OIDC/SAML identity provider
  // (see EnterpriseIdentityProvider). One OAuthAccount row per (ENTERPRISE,
  // providerAccountId) still applies the exact same never-merge/never-steal
  // invariants as every other provider — providerAccountId is namespaced as
  // "<enterpriseIdentityProviderId>:<subjectFromIdp>" so two different
  // orgs' IdPs can never collide on the same raw "sub".
  ENTERPRISE
}

enum EnterpriseIdentityProtocol {
  OIDC
  SAML
}

// Additive: DB-driven per-organization enterprise identity provider config
// (Furtail centralized-auth "enterprise organization login", see
// docs/wpa-central-auth-api-complete-audit.md item #10). Lets an org be
// onboarded without a code deploy. OIDC is implemented as an id_token
// verification path (JWKS-based, mirroring google/apple/microsoft
// adapters) plus authorization-code+PKCE initiation. SAML is modeled here
// but NOT implemented in this pass — requests against a SAML-protocol row
// get a PROVIDER_DISABLED/NOT_IMPLEMENTED response, never a faked login.
// Short-lived, single-use authorization code handed back to a MOBILE app on
// the social/enterprise system-browser callback, replacing the previous
// tokens-in-URI-fragment redirect. The session tokens are stored encrypted
// (AES-256-GCM via credentialEncryption) and released exactly once through
// POST /auth/mobile/token after PKCE verification. Bound to the requesting
// AuthClient, the exact redirect URI, and the S256 code challenge.
model MobileAuthorizationCode {
  id               String    @id @default(cuid())
  codeHash         String    @unique @map("code_hash")
  clientDbId       String    @map("client_db_id")
  redirectUri      String    @map("redirect_uri")
  codeChallenge    String    @map("code_challenge")
  payloadEncrypted String    @map("payload_encrypted")
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("mobile_authorization_codes")
}

model EnterpriseIdentityProvider {
  id                    String                     @id @default(cuid())
  orgSlug               String                     @unique @map("org_slug")
  displayName           String                     @map("display_name")
  protocol              EnterpriseIdentityProtocol @default(OIDC)
  enabled               Boolean                    @default(false)
  // OIDC fields
  issuer                String?
  clientId              String?                    @map("client_id")
  clientSecretEncrypted String?                    @map("client_secret_encrypted")
  jwksUri               String?                    @map("jwks_uri")
  authorizationUrl      String?                    @map("authorization_url")
  tokenUrl              String?                    @map("token_url")
  redirectUri           String?                    @map("redirect_uri")
  // SAML fields (modeled, not wired up — see module doc comment above)
  metadataUrl           String?                    @map("metadata_url")
  entityId              String?                    @map("entity_id")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")

  @@index([orgSlug])
  @@index([enabled, protocol])
  @@map("enterprise_identity_providers")
}

