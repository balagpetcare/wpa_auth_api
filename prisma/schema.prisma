model CommunicationDeliveryLog {
  id               String                      @id @default(cuid())
  channel          CommunicationChannel
  purpose          OtpTemplatePurpose
  recipient        String
  countryCode      String?                     @map("country_code")
  providerId       String?                     @map("provider_id")
  templateId       String?                     @map("template_id")
  otpId            String?                     @map("otp_id")
  status           CommunicationDeliveryStatus
  attemptNo        Int                         @default(1) @map("attempt_no")
  providerResponse Json?                       @map("provider_response")
  errorCode        String?                     @map("error_code")
  errorMessage     String?                     @map("error_message")
  sentAt           DateTime?                   @map("sent_at")
  failedAt         DateTime?                   @map("failed_at")
  createdAt        DateTime                    @default(now()) @map("created_at")

  // Retry/resend center (communication retry & dead-letter system).
  // isRetryable/retryPolicyKey are decided once at first-failure time from
  // the message's purpose/templateKey (see communication.retryPolicy.ts)
  // and never change afterwards, so the admin UI and worker always agree
  // on whether a given row is eligible for retry/manual resend.
  retryCount           Int       @default(0) @map("retry_count")
  maxRetries           Int       @default(0) @map("max_retries")
  nextRetryAt          DateTime? @map("next_retry_at")
  lastRetryAt          DateTime? @map("last_retry_at")
  lastErrorCode        String?   @map("last_error_code")
  lastErrorMessage     String?   @map("last_error_message")
  isRetryable          Boolean   @default(false) @map("is_retryable")
  retryPolicyKey       String?   @map("retry_policy_key")
  // Full chain of provider-level attempts across the original send and all
  // retries: [{ attemptNo, providerId, providerCode, success, errorCode,
  // errorMessage, at }]. Never contains secrets/credentials.
  providerAttemptChain Json?     @map("provider_attempt_chain")
  // Optimistic lock so the retry worker cannot double-send a row that's
  // concurrently being retried by another worker instance.
  lockedAt             DateTime? @map("locked_at")
  lockedBy             String?   @map("locked_by")
  cancelledAt          DateTime? @map("cancelled_at")
  deadLetterAt         DateTime? @map("dead_letter_at")
  // Safe resend payload (subject/text/html or SMS message + routing scope)
  // captured only for isRetryable=true rows — never populated for OTP/token
  // messages, so no raw OTP/verification code is ever persisted for retry.
  resendPayload        Json?     @map("resend_payload")
  redisJobId           String?   @map("redis_job_id")

  provider CommunicationProvider? @relation(fields: [providerId], references: [id])
  template OtpTemplate?           @relation(fields: [templateId], references: [id])

  @@index([channel, purpose, createdAt])
  @@index([recipient, createdAt])
  @@index([providerId, createdAt])
  @@index([createdAt, id])
  @@index([channel, createdAt, id])
  @@index([providerId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([status, nextRetryAt])
  @@index([isRetryable, status, createdAt, id])
  @@map("communication_delivery_logs")
}

